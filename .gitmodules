[submodule "vendor/llvmbpf"]
	path = vendor/llvmbpf
	url = https://github.com/eunomia-bpf/llvmbpf.git
[submodule "vendor/libbpf"]
	path = vendor/libbpf
	url = https://github.com/libbpf/libbpf.git
[submodule "vendor/linux-framework"]
	path = vendor/linux-framework
	url = https://github.com/eunomia-bpf/linux.git
[submodule "docs/paper"]
	path = docs/paper
	url = https://github.com/yunwei37/bpfrejit-paper
[submodule "llvm-backend/llvm"]
	path = llvm-backend/llvm
	url = https://github.com/eunomia-bpf/bpf-kinsn-llvm.git
	branch = main
[submodule "vendor/repos/katran"]
	path = vendor/repos/katran
	url = https://github.com/eunomia-bpf/katran.git
	branch = bpf-benchmark
[submodule "vendor/repos/tracee"]
	path = vendor/repos/tracee
	url = https://github.com/eunomia-bpf/tracee.git
[submodule "vendor/repos/tetragon"]
	path = vendor/repos/tetragon
	url = https://github.com/eunomia-bpf/tetragon.git
