	path = vendor/repos/cilium
	url = https://github.com/eunomia-bpf/cilium.git
[submodule "vendor/repos/bpftrace"]
	path = vendor/repos/bpftrace
	url = https://github.com/eunomia-bpf/bpftrace.git
[submodule "vendor/repos/bcc"]
	path = vendor/repos/bcc
	url = https://github.com/eunomia-bpf/bcc.git
[submodule "vendor/repos/opentelemetry-ebpf-profiler"]
	path = vendor/repos/opentelemetry-ebpf-profiler
