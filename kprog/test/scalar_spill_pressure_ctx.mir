--- |
  target triple = "bpf"
  @_license = constant [4 x i8] c"GPL\00", section "license", align 1
  define i32 @spill_values(ptr %context) section "socket" { ret i32 0 }
...
---
name:            spill_values
alignment:       8
tracksRegLiveness: true
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    8
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 4, alignment: 8,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
  - { id: 1, name: '', type: spill-slot, offset: 0, size: 4, alignment: 8,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $r1

    $r0 = COPY $r1
    $w2 = LDW32 $r1, 8
    $w3 = LDW32 killed $r1, 32
    $r4 = COPY $r2
    $r4 = ADD_ri killed $r4, 1
    $r5 = COPY $r3
    $r5 = ADD_ri killed $r5, 3
    $r6 = COPY $r2
    $r6 = ADD_ri killed $r6, 5
    $r7 = COPY $r3
    $r7 = ADD_ri killed $r7, 7
    $r8 = COPY $r2
    $r8 = XOR_ri killed $r8, -2147483648
    $r9 = COPY $r3
    $r9 = XOR_ri killed $r9, 2147483647
    $r1 = COPY $r2
    $r1 = ADD_ri killed $r1, 1
    STW32 killed $w1, %stack.0, 0
    $r1 = COPY $r3
    $r1 = ADD_ri killed $r1, 9
    STW32 killed $w1, %stack.1, 0
    JMP %bb.1

  bb.1:
    liveins: $r0, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9

    $w0 = LDW32 $r0, 8
    $r0 = ADD_ri killed $r0, 17
    $w1 = LDW32 %stack.0, 0
    $r0 = XOR_rr killed $r0, killed $r1
    $w1 = LDW32 %stack.1, 0
    $r0 = XOR_rr killed $r0, killed $r1
    $r0 = ADD_rr killed $r0, killed $r2
    $r0 = ADD_rr killed $r0, killed $r3
    $r0 = ADD_rr killed $r0, killed $r4
    $r0 = ADD_rr killed $r0, killed $r5
    $r0 = ADD_rr killed $r0, killed $r6
    $r0 = ADD_rr killed $r0, killed $r7
    $r0 = ADD_rr killed $r0, killed $r8
    $r0 = ADD_rr killed $r0, killed $r9
    RET implicit $r0
...
