    {
      "path": "runner/libs/app_runners/tetragon.py",
      "sha256": "6a57ef7dcb355ae5feefd23fcba0fb6515ff08eba46b2122620737497feea96d",
      "lines": [
        {
          "line": 100,
          "text": "DEFAULT_POLICY_DIR = ROOT_DIR / \"runner\" / \"assets\" / \"tetragon_policies\""
        },
        {
          "line": 101,
          "text": ""
        },
        {
          "line": 102,
          "text": ""
        },
        {
          "line": 103,
          "text": "def _free_loopback_address() -> str:"
        },
        {
          "line": 104,
          "text": "    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:"
        },
        {
          "line": 105,
          "text": "        sock.bind((\"127.0.0.1\", 0))"
        },
        {
          "line": 106,
          "text": "        return f\"127.0.0.1:{sock.getsockname()[1]}\""
        },
        {
          "line": 107,
          "text": ""
        },
        {
          "line": 108,
          "text": ""
        },
        {
          "line": 109,
          "text": "def resolve_tetragon_policy_dir() -> str:"
        },
        {
          "line": 110,
          "text": "    policy_dir = DEFAULT_POLICY_DIR.resolve()"
        },
        {
          "line": 111,
          "text": "    if not policy_dir.is_dir():"
        },
        {
          "line": 112,
          "text": "        raise RuntimeError(f\"missing upstream Tetragon policy dir: {policy_dir}\")"
        },
        {
          "line": 113,
          "text": "    if not any(policy_dir.rglob(\"*.yaml\")) and not any(policy_dir.rglob(\"*.yml\")):"
        },
        {
          "line": 114,
          "text": "        raise RuntimeError(f\"no upstream Tetragon policies found under {policy_dir}\")"
        },
        {
          "line": 115,
          "text": "    return str(policy_dir)"
        }
      ]
    },
    {
      "path": "runner/libs/app_runners/tetragon.py",
      "sha256": "6a57ef7dcb355ae5feefd23fcba0fb6515ff08eba46b2122620737497feea96d",
      "lines": [
        {
          "line": 138,
          "text": "        if resolved is None: raise RuntimeError(\"Tetragon binary not found; provide --tetragon-binary or prepare the upstream Tetragon container artifact\")"
        },
        {
          "line": 139,
          "text": "        return resolved"
        },
        {
          "line": 140,
          "text": ""
        },
        {
          "line": 141,
          "text": "    def start(self) -> list[int]:"
        },
        {
          "line": 142,
          "text": "        if self.session is not None: raise RuntimeError(\"TetragonRunner is already running\")"
        },
        {
          "line": 143,
          "text": "        tetragon_binary = self._resolve_binary()"
        },
        {
          "line": 144,
          "text": "        self.command = ["
        },
        {
          "line": 145,
          "text": "            tetragon_binary,"
        },
        {
          "line": 146,
          "text": "            \"--server-address\","
        },
        {
          "line": 147,
          "text": "            _free_loopback_address(),"
        },
        {
          "line": 148,
          "text": "            \"--health-server-address\","
        },
        {
          "line": 149,
          "text": "            _free_loopback_address(),"
        },
        {
          "line": 150,
          "text": "            \"--tracing-policy-dir\","
        },
        {
          "line": 151,
          "text": "            resolve_tetragon_policy_dir(),"
        },
        {
          "line": 152,
          "text": "        ]"
        },
        {
          "line": 153,
          "text": "        if tetragon_bpf_lib_dir := str((self.setup_result or {}).get(\"tetragon_bpf_lib_dir\") or \"\").strip():"
        },
        {
          "line": 154,
          "text": "            self.command.extend([\"--bpf-lib\", tetragon_bpf_lib_dir])"
        }
      ]
