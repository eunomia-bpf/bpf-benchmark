      "lines": [
        {
          "line": 120,
          "text": "__attribute__((section(COMMON), used)) int"
        },
        {
          "line": 121,
          "text": "generic_kprobe_process_filter(void *ctx)"
        },
        {
          "line": 122,
          "text": "{"
        },
        {
          "line": 123,
          "text": "\tint ret;"
        },
        {
          "line": 124,
          "text": ""
        },
        {
          "line": 125,
          "text": "\tret = generic_process_filter();"
        },
        {
          "line": 126,
          "text": "\tif (ret == PFILTER_CONTINUE)"
        },
        {
          "line": 127,
          "text": "\t\ttail_call(ctx, &kprobe_calls, TAIL_CALL_FILTER);"
        },
        {
          "line": 128,
          "text": "\telse if (ret == PFILTER_ACCEPT)"
        },
        {
          "line": 129,
          "text": "\t\ttail_call(ctx, &kprobe_calls, TAIL_CALL_SETUP);"
        },
        {
          "line": 130,
          "text": "\t/* If filter does not accept drop it. Ideally we would"
        },
        {
          "line": 131,
          "text": "\t * log error codes for later review, TBD."
        },
        {
          "line": 132,
          "text": "\t */"
        },
        {
          "line": 133,
          "text": "\treturn PFILTER_REJECT;"
        },
        {
          "line": 134,
          "text": "}"
        },
        {
          "line": 135,
          "text": ""
        }
      ]
