          "text": ""
        },
        {
          "line": 79,
          "text": "// generic_process_filter return value"
        },
        {
          "line": 80,
          "text": "enum {"
        },
        {
          "line": 81,
          "text": "\tPFILTER_ERROR = 3, // these should never happen"
        },
        {
          "line": 82,
          "text": "\tPFILTER_CONTINUE = 2, // filter check continue"
        },
        {
          "line": 83,
          "text": "\tPFILTER_ACCEPT = 1, // filter check passed"
        },
        {
          "line": 84,
          "text": "\tPFILTER_REJECT = 0, // filter check failed"
        },
