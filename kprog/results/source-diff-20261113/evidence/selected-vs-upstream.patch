+{
+	for (size_t i = 0; i < len; i++) {
+		size_t j = 0;
+
+		for (; j < 100 && i + j < len; j++) {
+			char c2 = s2__ign[j];
+
+			if (!c2)
+				return (int)i;
+			if (s1__ign[i + j] != c2)
+				break;
+		}
+	}
