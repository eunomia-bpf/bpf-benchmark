# kprog_spill_scratch_0: 494
body:             |
  bb.0 (%ir-block.1):
    successors: %bb.3806(0x30000000), %bb.1(0x50000000)
    liveins: $r1
  
    $r0 = MOV_ri 0
    STD killed $r0, %stack.374, 0
    $r0 = MOV_ri 0
    STD killed $r0, %stack.381, 0
    $r0 = MOV_ri 0
    STD killed $r0, %stack.391, 0
    $r0 = MOV_ri 0
    STD killed $r0, %stack.393, 0
    $r0 = MOV_ri 0
    STD killed $r0, %stack.395, 0
    $r0 = MOV_ri 0
    STD killed $r0, %stack.486, 0
    $r0 = MOV_ri 0
    STD killed $r0, %stack.490, 0
    $r6 = COPY $r1
    $r2 = MOV_rr %stack.354
    STD $r2, %stack.354, 0, debug-location !7999 :: (volatile store (s64) into %ir.356)
    INLINEASM &"r1 = $1\0Aw1 = w1\0A$0 = r1", 1 /* sideeffect attdialect */, 131082 /* regdef:GPR */, def $r2, 131081 /* reguse:GPR */, killed $r2, 12 /* clobber */, implicit-def dead early-clobber $r1, debug-location !7999
    STW32 $w2, %stack.354, 0, implicit killed $r2, debug-location !7999 :: (volatile store (s32) into %ir.356, align 8)
    $r1 = LDD %stack.354, 0, debug-location !7999 :: (volatile dereferenceable load (s64) from %ir.356)
    STD killed $r1, %stack.355, 0, debug-location !7999
    $r7 = LD_imm64 @kprog_unspecified_input, debug-location !7999
    $r1 = LDD $r7, 0, debug-location !7999 :: (volatile load (s64) from @kprog_unspecified_input, !tbaa !8001)
