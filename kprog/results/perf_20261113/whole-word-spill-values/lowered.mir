--- |
  target triple = "bpf"
  @_license = constant [4 x i8] c"GPL\00", section "license", align 1
  define i32 @spill_values(ptr %context) section "socket" { ret i32 0 }
...
---
name:            spill_values
alignment:       8
tracksRegLiveness: true
liveins:
  - { reg: '$r1', virtual-reg: '' }
frameInfo:
  maxAlignment:    8
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 8, alignment: 8,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $r1

    $r0 = MOV_ri 0
    STD killed $r0, %stack.0, 0
    $w2 = LDW32 $r1, 8
    $w3 = LDW32 killed $r1, 32
    $w6 = COPY $w3, implicit-def $r6
    $r0 = LDD %stack.0, 0
    $r0 = SRL_ri killed $r0, 32
    $r0 = SLL_ri killed $r0, 32
    $w1 = COPY $w2, implicit-def $r1
    $r0 = OR_rr killed $r0, killed $r1
    STD killed $r0, %stack.0, 0
    $r0 = LDD %stack.0, 0
    $r0 = SLL_ri killed $r0, 32
    $r0 = SRL_ri killed $r0, 32
    $w1 = COPY $w3, implicit-def $r1
    $r1 = SLL_ri killed $r1, 32
    $r0 = OR_rr killed $r0, killed $r1
    STD killed $r0, %stack.0, 0
    JMP %bb.1

  bb.1:
    liveins: $r6

    $r2 = LDD %stack.0, 0
    $r2 = SLL_ri killed $r2, 32
    $r2 = SRL_ri killed $r2, 32
    $r3 = LDD %stack.0, 0
    $r3 = SRL_ri killed $r3, 32
    $r2 = XOR_rr killed $r2, $r3
    $r0 = LDD %stack.0, 0
    $r0 = SRL_ri killed $r0, 32
    $r0 = SLL_ri killed $r0, 32
    $w1 = COPY $w2, implicit-def $r1
    $r0 = OR_rr killed $r0, killed $r1
    STD killed $r0, %stack.0, 0
    $r3 = ADD_ri killed $r3, 12345
    $r0 = LDD %stack.0, 0
    $r0 = SLL_ri killed $r0, 32
    $r0 = SRL_ri killed $r0, 32
    $w1 = COPY $w3, implicit-def $r1
    $r1 = SLL_ri killed $r1, 32
    $r0 = OR_rr killed $r0, killed $r1
    STD killed $r0, %stack.0, 0
    $r2 = LDD %stack.0, 0
    $r2 = SLL_ri killed $r2, 32
    $r2 = SRL_ri killed $r2, 32
    $r3 = LDD %stack.0, 0
    $r3 = SRL_ri killed $r3, 32
    $r0 = COPY killed $r2
    $r0 = XOR_rr killed $r0, killed $r3
    $r0 = XOR_rr killed $r0, killed $r6
    RET implicit $r0
...
