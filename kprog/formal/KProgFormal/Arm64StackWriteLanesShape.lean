import KProgFormal.GeneratedArm64StackWriteLanes
import KProgFormal.GeneratedArm64Width
import KProgFormal.GeneratedArm64ByteLane
import KProgFormal.GeneratedArm64StoreBytes
import KProgFormal.Arm64Width

namespace KProgFormal

open GeneratedArm64StackWriteLanes (Width Lane widthCode byteCount widthMask
  laneIndex laneActive activeLanes laneSpec)

/-- Independent statement of the byte count of an access width, built from the
literal width sizes rather than the generated `byteCount`. -/
def arm64StackWriteLanesCountSpec : Width -> Nat
  | .w8 => 1
  | .w16 => 2
  | .w32 => 4
  | .w64 => 8

/-- Independent statement of the active-lane mask of an access width: the low
`count` bits set, built from the literal mask values rather than the generated
`widthMask`. -/
def arm64StackWriteLanesMaskSpec : Width -> Nat
  | .w8 => 1
  | .w16 => 3
  | .w32 => 15
  | .w64 => 255

/-- Independent statement of the lane number, built from the literal lane order
rather than the generated `laneIndex`. -/
def arm64StackWriteLanesLaneSpec : Lane -> Nat
  | .lane0 => 0
  | .lane1 => 1
  | .lane2 => 2
  | .lane3 => 3
  | .lane4 => 4
  | .lane5 => 5
  | .lane6 => 6
  | .lane7 => 7

/-- The generated active-lane mask equals the independent literal mask, so the
C `KPROG_ARM64_STACK_WRITE_MASK` chain names the same low-bit sets. -/
theorem arm64_stack_write_lanes_mask_refines (width : Width) :
    widthMask width = arm64StackWriteLanesMaskSpec width := by
  cases width <;> rfl

/-- The generated byte count equals the independent literal size. -/
theorem arm64_stack_write_lanes_count_refines (width : Width) :
    byteCount width = arm64StackWriteLanesCountSpec width := by
  cases width <;> rfl

/-- The generated lane number equals the independent literal lane order. -/
theorem arm64_stack_write_lanes_lane_refines (lane : Lane) :
    laneIndex lane = arm64StackWriteLanesLaneSpec lane := by
  cases lane <;> rfl

/-- **The activation contract.** A lane is written exactly when its index is
below the width's byte count: the mask's low bits set is the same monotone
activation the four hand-written width gates recomputed. Stated as an explicit
`decide` so the closed finite table closes it. -/
theorem arm64_stack_write_lanes_refines (width : Width) (lane : Lane) :
    laneActive width lane =
      decide (arm64StackWriteLanesLaneSpec lane <
        arm64StackWriteLanesCountSpec width) := by
  cases width <;> cases lane <;> decide

/-- The generated mask-bit activation agrees with the byte-count bound, stated
against the generated `laneSpec`. -/
theorem arm64_stack_write_lanes_spec_iff (width : Width) (lane : Lane) :
    laneActive width lane = true ↔
      arm64StackWriteLanesLaneSpec lane <
        arm64StackWriteLanesCountSpec width := by
  cases width <;> cases lane <;> decide

/-- The active-lane set has exactly the width's byte count, so the byte ladder
writes exactly `n` bytes at width `n`. -/
theorem arm64_stack_write_lanes_length (width : Width) :
    (activeLanes width).length = byteCount width :=
  GeneratedArm64StackWriteLanes.activeLanes_length width

/-- The mask is the width's low `byteCount` bits set. -/
theorem arm64_stack_write_lanes_mask_is_low_bits (width : Width) :
    widthMask width = 2 ^ byteCount width - 1 :=
  GeneratedArm64StackWriteLanes.widthMask_is_low_bits width

/-- **Monotonicity.** An active lane stays active at every wider access: the
activation set of a narrower width is a subset of that of a wider one, which is
exactly the nested `>= 16`, `>= 32`, `== 64` gate structure the ladder had. -/
theorem arm64_stack_write_lanes_monotone (width width' : Width) (lane : Lane)
    (hsub : byteCount width ≤ byteCount width')
    (h : laneActive width lane = true) :
    laneActive width' lane = true := by
  revert hsub h
  cases width <;> cases width' <;> cases lane <;> decide

/-- Lane 0 is always written at every width, so the ladder's unconditional first
byte is the `laneActive` contract at lane 0. -/
theorem arm64_stack_write_lanes_lane0_always (width : Width) :
    laneActive width .lane0 = true := by
  cases width <;> decide

/-- A lane above the width's byte count is never written, so no byte past the
access window is touched. -/
theorem arm64_stack_write_lanes_above_never (width : Width) (lane : Lane)
    (h : byteCount width ≤ arm64StackWriteLanesLaneSpec lane) :
    laneActive width lane = false := by
  revert h
  cases width <;> cases lane <;> decide

/-- **The width codes are the width contract's.** The generated stack-write
width codes are the `Arm64Width` codes, so the ladder's gate widths and the
width-narrowing value use one code set. -/
theorem arm64_stack_write_lanes_codes_match_width :
    List.map widthCode [.w8, .w16, .w32, .w64] =
      List.map arm64WidthCodeSpec [.w8, .w16, .w32, .w64] := by
  rfl

/-- **The activation is the store-bytes ladder's lane set.** The write ladder's
per-width byte counts and width codes are exactly the memory-side `KPROG_ARM64_
STORE_BYTES` contract's, so the stack byte ladder and the memory byte ladder
activate the same lanes at every width. -/
theorem arm64_stack_write_lanes_matches_store_bytes :
    List.map byteCount [.w8, .w16, .w32, .w64] =
        List.map GeneratedArm64StoreBytes.byteCount [.w8, .w16, .w32, .w64] ∧
      List.map widthCode [.w8, .w16, .w32, .w64] =
        List.map GeneratedArm64StoreBytes.widthCode [.w8, .w16, .w32, .w64] := by
  exact ⟨rfl, rfl⟩

/-- The lane's byte-lane extraction is the one the byte-lane contract defines:
lane `k` of the write ladder is `GeneratedArm64ByteLane.byteAt` at lane `k`, so
the written byte and the extracted byte are the same eight-bit slice. -/
theorem arm64_stack_write_lanes_lane_is_byte_lane (lane : Lane) :
    GeneratedArm64ByteLane.shift
        (match lane with
         | .lane0 => .lane0 | .lane1 => .lane1 | .lane2 => .lane2
         | .lane3 => .lane3 | .lane4 => .lane4 | .lane5 => .lane5
         | .lane6 => .lane6 | .lane7 => .lane7) =
      8 * arm64StackWriteLanesLaneSpec lane := by
  cases lane <;> rfl

/-- The lanes a stack access of the width writes, in lane order, at each of the
four widths: the four nested gates the ladder keeps resolve to these exact
nineteen lane writes. -/
theorem arm64_stack_write_lanes_over_widths :
    List.map (fun w => (activeLanes w).length) [.w8, .w16, .w32, .w64] =
        [1, 2, 4, 8] ∧
      List.map (fun w => widthMask w) [.w8, .w16, .w32, .w64] =
        [1, 3, 15, 255] := by
  refine ⟨rfl, rfl⟩

/-- Canonical example: a halfword stack write activates lanes 0 and 1. -/
theorem arm64_stack_write_lanes_w16_example :
    laneActive .w16 .lane0 = true ∧
      laneActive .w16 .lane1 = true ∧
      laneActive .w16 .lane2 = false := by
  refine ⟨?_, ?_, ?_⟩ <;> decide

/-- Canonical example: a word stack write activates lanes 0..3 and no higher
byte. -/
theorem arm64_stack_write_lanes_w32_example :
    laneActive .w32 .lane3 = true ∧
      laneActive .w32 .lane4 = false ∧
      widthMask .w32 = 15 := by
  refine ⟨?_, ?_, ?_⟩ <;> decide

/-- Canonical example: only the doubleword write activates the top lane. -/
theorem arm64_stack_write_lanes_w64_top_example :
    laneActive .w64 .lane7 = true ∧
      laneActive .w8 .lane7 = false ∧
      laneActive .w32 .lane7 = false := by
  refine ⟨?_, ?_, ?_⟩ <;> decide

end KProgFormal
