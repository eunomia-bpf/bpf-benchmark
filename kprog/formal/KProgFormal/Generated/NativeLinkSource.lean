  fromList (armWordBytes source (start+i/4*4)) (i%4)

def armCopyImage (destination source : Image) (destinationAt sourceAt words : Nat) : Image :=
  copy destination destinationAt (armCopiedByte source sourceAt) 0 (words*4)

