import KProgFormal.GeneratedX86Bswap
import KProgFormal.GeneratedX86Width
import Std.Tactic.BVDecide

namespace KProgFormal

open GeneratedX86Width (Width mask narrow bits)
open GeneratedX86Bswap (value)

private def lane8 (v : BitVec 64) (i : Nat) : BitVec 64 :=
  (v.extractLsb' (8 * i) 8).setWidth 64

/-- Independent statement of the x86 byte reversal: the access width's bytes in
reverse lane order, assembled from per-byte extractions rather than the
generated mask-and-shift ladder. A one-byte access keeps its byte. -/
def x86BswapSpec (v : BitVec 64) : Width -> BitVec 64
  | .w8 => v &&& mask .w8
  | .w16 => narrow (lane8 v 0 <<< 8 ||| lane8 v 1) .w16
  | .w32 =>
      narrow (lane8 v 0 <<< 24 ||| lane8 v 1 <<< 16 |||
              lane8 v 2 <<< 8 ||| lane8 v 3) .w32
  | .w64 =>
      lane8 v 0 <<< 56 ||| lane8 v 1 <<< 48 ||| lane8 v 2 <<< 40 |||
      lane8 v 3 <<< 32 ||| lane8 v 4 <<< 24 ||| lane8 v 5 <<< 16 |||
      lane8 v 6 <<< 8 ||| lane8 v 7

/-- The generated byte reversal equals the independent lane assembly for all four
widths. -/
theorem x86_bswap_refines (v : BitVec 64) (width : Width) :
    value v width = x86BswapSpec v width := by
  cases width <;>
    simp only [value, x86BswapSpec, lane8, mask, narrow] <;>
    bv_decide

/-- The reversal is an involution on every width: applying it twice returns the
original value, because reversing the byte order twice restores it. -/
theorem x86_bswap_involutive (v : BitVec 64) (width : Width) :
    value (value v width) width = v &&& mask width := by
  cases width <;> simp only [value, mask, narrow] <;> bv_decide

/-- A doubleword byte reversal clears the high word, so a 32-bit BSWAP/MOVBE
never leaves stale high bytes. -/
theorem x86_bswap_w32_clears_high (v : BitVec 64) :
    value v .w32 >>> 32 = 0 := by
  simp only [value, mask]
  bv_decide

/-- Canonical example: a 64-bit reversal swaps the byte order. -/
theorem x86_bswap_w64_example :
    value 0x0123456789abcdef .w64 = 0xefcdab8967452301 := by
  native_decide

/-- Canonical example: a 32-bit reversal reverses the low four bytes only. -/
theorem x86_bswap_w32_example :
    value 0x0123456789abcdef .w32 = 0xefcdab89 := by
  native_decide

/-- Canonical example: a one-byte access is unchanged (the low byte). -/
theorem x86_bswap_w8_example :
    value 0x0123456789abcdef .w8 = 0xef := by
  native_decide

end KProgFormal
