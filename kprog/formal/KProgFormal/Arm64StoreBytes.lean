import KProgFormal.GeneratedArm64StoreBytes
import KProgFormal.GeneratedArm64Width
import KProgFormal.Arm64LoadBytes
import Std.Tactic.BVDecide

namespace KProgFormal

open GeneratedArm64StoreBytes (StoreWidth)
open GeneratedArm64Width (Width mask)

/-- Independent statement of the AArch64 little-endian store: writing the width's
low `n` bytes of `value` into memory and reading the covered word back. It is
stated as a lane-by-lane assembly (each written byte sits in its own lane, every
higher lane zero) — the write-then-read image — not as the masked truncation the
generated `image` uses, and `byteCount` ties the width to `n`. -/
def arm64StoreBytesSpec (width : StoreWidth) (value : BitVec 64) : BitVec 64 :=
  match width with
  | .w8 =>
    (((value >>> 0) &&& 0xff) <<< 0)
  | .w16 =>
    (((value >>> 0) &&& 0xff) <<< 0) |||
    (((value >>> 8) &&& 0xff) <<< 8)
  | .w32 =>
    (((value >>> 0) &&& 0xff) <<< 0) |||
    (((value >>> 8) &&& 0xff) <<< 8) |||
    (((value >>> 16) &&& 0xff) <<< 16) |||
    (((value >>> 24) &&& 0xff) <<< 24)
  | .w64 =>
    (((value >>> 0) &&& 0xff) <<< 0) |||
    (((value >>> 8) &&& 0xff) <<< 8) |||
    (((value >>> 16) &&& 0xff) <<< 16) |||
    (((value >>> 24) &&& 0xff) <<< 24) |||
    (((value >>> 32) &&& 0xff) <<< 32) |||
    (((value >>> 40) &&& 0xff) <<< 40) |||
    (((value >>> 48) &&& 0xff) <<< 48) |||
    (((value >>> 56) &&& 0xff) <<< 56)

/-- The generated masked store image equals the independent lane-by-lane
write-then-read model for all four store widths. -/
theorem arm64_store_bytes_refines (width : StoreWidth) (value : BitVec 64) :
    GeneratedArm64StoreBytes.image width value =
      arm64StoreBytesSpec width value := by
  cases width <;>
    simp only [GeneratedArm64StoreBytes.image, arm64StoreBytesSpec] <;>
    bv_decide

/-- The generated byte counts are 1, 2, 4 and 8, and the generated width codes
are the four `ARM64_WIDTH_*` values, so the C ladder's comparison chain covers
each width exactly once. -/
theorem arm64_store_bytes_width_dispatch :
    GeneratedArm64StoreBytes.byteCount .w8 = 1 ∧
    GeneratedArm64StoreBytes.byteCount .w16 = 2 ∧
    GeneratedArm64StoreBytes.byteCount .w32 = 4 ∧
    GeneratedArm64StoreBytes.byteCount .w64 = 8 ∧
    GeneratedArm64StoreBytes.widthCode .w8 = 1 ∧
    GeneratedArm64StoreBytes.widthCode .w16 = 2 ∧
    GeneratedArm64StoreBytes.widthCode .w32 = 4 ∧
    GeneratedArm64StoreBytes.widthCode .w64 = 8 := by
  refine ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- A narrow store never touches a byte above its own width: the covered word's
bytes above the store width are zero. -/
theorem arm64_store_bytes_upper_cleared (value : BitVec 64) :
    arm64StoreBytesSpec .w8 value >>> 8 = 0 ∧
    arm64StoreBytesSpec .w16 value >>> 16 = 0 ∧
    arm64StoreBytesSpec .w32 value >>> 32 = 0 := by
  simp only [arm64StoreBytesSpec]
  refine ⟨?_, ?_, ?_⟩ <;> bv_decide

/-- The store image is exactly the value the load contract yields at the same
width: writing the width's low bytes and reading the covered word back agrees
with `arm64LoadBytesSpec` for all four widths, so the store and load ladders are
a matched pair. -/
theorem arm64_store_bytes_load_agree (value : BitVec 64) :
    arm64LoadBytesSpec .w8 value = GeneratedArm64StoreBytes.image .w8 value ∧
    arm64LoadBytesSpec .w16 value = GeneratedArm64StoreBytes.image .w16 value ∧
    arm64LoadBytesSpec .w32 value = GeneratedArm64StoreBytes.image .w32 value ∧
    arm64LoadBytesSpec .w64 value = GeneratedArm64StoreBytes.image .w64 value := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    simp only [arm64LoadBytesSpec, GeneratedArm64StoreBytes.image,
      GeneratedArm64Width.mask] <;>
    bv_decide

/-- Canonical example: a halfword store keeps the low two bytes little-endian. -/
theorem arm64_store_bytes_w16_example :
    arm64StoreBytesSpec .w16 0x0123456789abcdef = 0xcdef := by
  native_decide

/-- Canonical example: a word store drops the high word. -/
theorem arm64_store_bytes_w32_example :
    arm64StoreBytesSpec .w32 0x0123456789abcdef = 0x89abcdef := by
  native_decide

/-- Canonical example: a doubleword store keeps all eight bytes. -/
theorem arm64_store_bytes_w64_example :
    arm64StoreBytesSpec .w64 0x0123456789abcdef = 0x0123456789abcdef := by
  native_decide

end KProgFormal
