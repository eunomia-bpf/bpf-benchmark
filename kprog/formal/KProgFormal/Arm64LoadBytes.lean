import KProgFormal.GeneratedArm64LoadBytes
import KProgFormal.GeneratedArm64Width
import Std.Tactic.BVDecide

namespace KProgFormal

open GeneratedArm64LoadBytes (LoadWidth)
open GeneratedArm64Width (Width mask)

/-- Independent statement of the AArch64 little-endian load: the low `n` bytes of
the source word, each in its own lane, with the bytes above `n` cleared. It is
stated as a masked truncation (`narrow` to the width's mask) of the whole word,
not as a lane-by-lane assembly, and `byteCount` ties the width to `n`. -/
def arm64LoadBytesSpec (width : LoadWidth) (value : BitVec 64) : BitVec 64 :=
  match width with
  | .w8 => value &&& mask .w8
  | .w16 => value &&& mask .w16
  | .w32 => value &&& mask .w32
  | .w64 => value &&& mask .w64

/-- The generated lane assembly equals the independent masked truncation for all
four load widths. -/
theorem arm64_load_bytes_refines (width : LoadWidth) (value : BitVec 64) :
    GeneratedArm64LoadBytes.value width value =
      arm64LoadBytesSpec width value := by
  cases width <;>
    simp only [GeneratedArm64LoadBytes.value, arm64LoadBytesSpec,
      GeneratedArm64Width.mask] <;>
    bv_decide

/-- The generated byte counts are 1, 2, 4 and 8, and the generated width codes
are the four `ARM64_WIDTH_*` values, so the C ladder's comparison chain covers
each width exactly once. -/
theorem arm64_load_bytes_width_dispatch :
    GeneratedArm64LoadBytes.byteCount .w8 = 1 ∧
    GeneratedArm64LoadBytes.byteCount .w16 = 2 ∧
    GeneratedArm64LoadBytes.byteCount .w32 = 4 ∧
    GeneratedArm64LoadBytes.byteCount .w64 = 8 ∧
    GeneratedArm64LoadBytes.widthCode .w8 = 1 ∧
    GeneratedArm64LoadBytes.widthCode .w16 = 2 ∧
    GeneratedArm64LoadBytes.widthCode .w32 = 4 ∧
    GeneratedArm64LoadBytes.widthCode .w64 = 8 := by
  refine ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- A narrow load never reads above its own width: the generated value's bytes
above the load width are zero. -/
theorem arm64_load_bytes_upper_cleared (value : BitVec 64) :
    arm64LoadBytesSpec .w8 value >>> 8 = 0 ∧
    arm64LoadBytesSpec .w16 value >>> 16 = 0 ∧
    arm64LoadBytesSpec .w32 value >>> 32 = 0 := by
  simp only [arm64LoadBytesSpec]
  refine ⟨?_, ?_, ?_⟩ <;>
    (simp only [GeneratedArm64Width.mask] <;> bv_decide)

/-- Canonical example: a halfword load takes the low two bytes little-endian. -/
theorem arm64_load_bytes_w16_example :
    arm64LoadBytesSpec .w16 0x0123456789abcdef = 0xcdef := by
  native_decide

/-- Canonical example: a word load drops the high word. -/
theorem arm64_load_bytes_w32_example :
    arm64LoadBytesSpec .w32 0x0123456789abcdef = 0x89abcdef := by
  native_decide

/-- Canonical example: a doubleword load keeps all eight bytes. -/
theorem arm64_load_bytes_w64_example :
    arm64LoadBytesSpec .w64 0x0123456789abcdef = 0x0123456789abcdef := by
  native_decide

end KProgFormal
