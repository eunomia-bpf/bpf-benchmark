import KProgFormal.Refinement.X86Andn
import KProgFormal.X86MemShiftHandler

namespace KProgFormal.Refinement.X86BmiShift

open Reference
open Reference.X86 (BzhiWidth BmiShift ShiftCount Register Source)
open X86Bzhi (handlerWidth readWidth)

def value (width : BzhiWidth) (kind : BmiShift) (source count : Reference.Word) : Reference.Word :=
  match kind with
  | .left => GeneratedX86ShiftResult.shl source count (handlerWidth width)
  | .right => GeneratedX86ShiftResult.shr source count (handlerWidth width)
  | .arithmetic => GeneratedX86ShiftResult.sar source count (handlerWidth width)
  | .rotate => GeneratedX86ShiftResult.ror source count (handlerWidth width)

theorem value_refines (width : BzhiWidth) (kind : BmiShift) (source count : Reference.Word) :
    value width kind source count &&& X86Andn.mask width =
      Reference.X86.bmiShiftValue width kind source count := by
  cases width <;> cases kind <;>
    simp only [value, handlerWidth, GeneratedX86ShiftResult.shl, GeneratedX86ShiftResult.shr,
      GeneratedX86ShiftResult.sar, GeneratedX86ShiftResult.ror,
      GeneratedX86ShiftCount.count, GeneratedX86ShiftCount.mask,
      GeneratedX86Width.narrow, GeneratedX86Width.mask, GeneratedX86Width.signMask,
      GeneratedX86Width.bits, X86Andn.mask, Reference.X86.bmiShiftValue,
      Reference.X86.BzhiWidth.bits, Reference.X86.BzhiWidth.bytes, Reference.Word] <;> bv_decide

/-- Generated byte reads and shift/count/result/writeback contracts supply both
register and memory routes. Count and source aliasing use the incoming state. -/
def handlerStep (width : BzhiWidth) (kind : BmiShift) (dst : Register) (source : Source)
    (count : ShiftCount) (nextPc : Reference.Word) (s : Reference.X86.State) (tag : Tag) :
    Transition Reference.X86.State :=
  match X86Bt.readOperand (readWidth width) source s with
  | .error fault => ⟨s, [.fault fault], some fault⟩
  | .ok (source, events) =>
      let result := value width kind source (Reference.X86.countValue s count)
      let written := generatedX86RegWrite ⟨s.gpr dst, tag⟩ result (handlerWidth width)
      ⟨{ s with gpr := (fun r => if r = dst then written.bits else s.gpr r), pc := nextPc }, events, none⟩

theorem step_refines (width : BzhiWidth) (kind : BmiShift) (dst : Register) (source : Source)
    (count : ShiftCount) (nextPc : Reference.Word) (s : Reference.X86.State) (tag : Tag) :
    handlerStep width kind dst source count nextPc s tag =
      Reference.X86.step (.bmiShift width kind dst source count nextPc) s := by
  simp only [handlerStep, Reference.X86.step, Reference.X86.bmiShiftStep, X86Bt.read_refines,
    X86Andn.writeback_refines, value_refines]
  cases width <;> rfl

theorem handler_refines (width : BzhiWidth) (kind : BmiShift) (dst : Register) (source : Source)
    (count : ShiftCount) (nextPc : Reference.Word) (s : Reference.X86.State) (tag : Tag) :
    Reference.X86.Step (.bmiShift width kind dst source count nextPc) s
      (handlerStep width kind dst source count nextPc s tag) := by
  rw [step_refines]
  exact ⟨rfl, rfl, rfl⟩

end KProgFormal.Refinement.X86BmiShift
