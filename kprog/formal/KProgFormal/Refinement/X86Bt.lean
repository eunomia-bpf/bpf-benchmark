import KProgFormal.X86BtHandler
import KProgFormal.Refinement.X86Cmov

namespace KProgFormal.Refinement.X86Bt

open Reference
open Reference.X86 (CmovWidth Source Register BitIndex)
open X86Cmov (handlerWidth)

/-- The three operand routes implemented by BT, BT_IMM and BT_MEM_IMM. -/
inductive Operands
  | registers (base index : Register)
  | immediate (base : Register) (index : Byte)
  | memory (address : Reference.Word) (index : Byte)

def Operands.op : Operands → X86BtOp
  | .registers .. => .bt
  | .immediate .. => .btImm
  | .memory .. => .btMemImm

def Operands.source : Operands → Source
  | .registers base _ | .immediate base _ => .register base
  | .memory address _ => .memory address

def Operands.index : Operands → BitIndex
  | .registers _ index => .register index
  | .immediate _ index | .memory _ index => .immediate index

def instruction (width : CmovWidth) (operands : Operands) (nextPc : Reference.Word) :
    Reference.X86.Instruction :=
  .bt width operands.source operands.index nextPc

/-- The production table's raw/immediate32 index routes all select the same
architectural bit. Native immediate bytes are zero-extended into packed fields. -/
theorem carry_refines (width : CmovWidth) (op : X86BtOp)
    (base index rawImm : Reference.Word) :
    generatedX86BtCf base (generatedX86BtIndex op index rawImm) (handlerWidth width) =
      Reference.X86.bitTest base
        (if op = .bt then index else (rawImm.setWidth 8).setWidth 64) width.bits := by
  cases width <;> cases op <;>
    simp only [generatedX86BtCf, generatedX86BtIndex, GeneratedX86Bt.indexSource,
      x86BtToOp, GeneratedX86Immediate.value, handlerWidth,
      GeneratedX86Bitops.bt, GeneratedX86Bitops.widthMask, GeneratedX86Width.code,
      Reference.X86.bitTest, Reference.X86.CmovWidth.bits, Reference.X86.CmovWidth.bytes, Reference.Word, reduceCtorEq, ↓reduceIte] <;>
    bv_decide

/-- Connect the carry to the existing full generated-handler composition. -/
theorem generated_step_carry (op : X86BtOp) (flags : GeneratedX86Store.Code)
    (base index immediate : Reference.Word) (byte : Nat → X86MemByte)
    (old : X86RegValue) (zf sf of : Bool) :
    (generatedX86BtStep op flags base index immediate byte old zf sf of).cf =
      generatedX86BtCf (generatedX86BtBase op base byte (generatedX86BtWriteWidth flags))
        (generatedX86BtIndex op index immediate) (generatedX86BtWriteWidth flags) := rfl

/-- Generated byte-ladder access, with architectural permission and read effects. -/
def readOperand (width : CmovWidth) (source : Source) (s : Reference.X86.State) :
    Except Fault (Reference.Word × List Event) :=
  match source with
  | .register r => .ok (s.gpr r, [])
  | .memory address =>
      if permitted s.memory.readable address width.bytes then
        .ok (GeneratedX86MemAccess.load
          (fun i => s.memory.value (address + BitVec.ofNat 64 i)) (handlerWidth width),
          [.memory .read address (bytesAt s.memory address width.bytes)
            (initializedAt s.memory address width.bytes)])
      else .error (.read address width.bytes)

theorem read_refines (width : CmovWidth) (source : Source) (s : Reference.X86.State) :
    readOperand width source s = Reference.X86.readSource s source width.bytes := by
  cases source with
  | register r => rfl
  | memory address =>
      cases h : permitted s.memory.readable address width.bytes <;>
        simp [readOperand, Reference.X86.readSource, readMemory,
        X86Cmov.memory_value_refines, h]

/-- All three handler routes lifted to complete architectural state/effects. -/
def handlerStep (width : CmovWidth) (operands : Operands) (nextPc : Reference.Word)
    (s : Reference.X86.State) : Transition Reference.X86.State :=
  match readOperand width operands.source s with
  | .error fault => ⟨s, [.fault fault], some fault⟩
  | .ok (value, events) =>
      let index := Reference.X86.bitIndexValue s operands.index
      let cf := generatedX86BtCf value
        (generatedX86BtIndex operands.op index index) (handlerWidth width)
      ⟨{ s with rflags := Reference.X86.setFlag s.rflags 0 cf, pc := nextPc }, events, none⟩

/-- Exact representative equality includes every register, vector, memory byte,
PC, fault and ordered access event; undefined flags can additionally vary in Step. -/
theorem step_refines (width : CmovWidth) (operands : Operands) (nextPc : Reference.Word)
    (s : Reference.X86.State) :
    handlerStep width operands nextPc s = Reference.X86.step (instruction width operands nextPc) s := by
  cases operands <;>
    simp [handlerStep, instruction, Operands.source, Operands.index, Operands.op,
      read_refines, Reference.X86.step, Reference.X86.bitBaseSource,
      Reference.X86.bitIndexValue, carry_refines] <;> rfl

/-- The handler's representative satisfies the architectural relation, whose
undefined flag bits remain unconstrained. -/
theorem handler_refines (width : CmovWidth) (operands : Operands) (nextPc : Reference.Word)
    (s : Reference.X86.State) :
    Reference.X86.Step (instruction width operands nextPc) s
      (handlerStep width operands nextPc s) := by
  rw [step_refines]
  exact ⟨rfl, rfl, rfl⟩

end KProgFormal.Refinement.X86Bt
