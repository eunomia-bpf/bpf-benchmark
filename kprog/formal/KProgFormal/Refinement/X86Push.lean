import KProgFormal.Refinement.X86Pop

namespace KProgFormal.Refinement.X86Push

open Reference
open Reference.X86 (StackWidth Register)
open X86Pop (handlerWidth widthCode)

/-- Low bytes emitted by the generated store ladder equal the architectural
little-endian store. Bits above a sixteen-bit PUSH cannot reach either byte. -/
theorem store_byte_refines (width : StackWidth) (value : Reference.Word) (i : Nat)
    (h : i < width.bytes) :
    GeneratedX86MemAccess.store value (handlerWidth width) i =
      (value >>> (8 * i)).setWidth 8 := by
  cases width with
  | w16 =>
      have hi : i = 0 ∨ i = 1 := by simp only [Reference.X86.StackWidth.bytes] at h; omega
      rcases hi with rfl | rfl <;>
        simp only [GeneratedX86MemAccess.store, GeneratedX86MemAccess.storeByte,
          handlerWidth, Reference.X86.StackWidth.registerWidth, X86Cmov.handlerWidth,
          GeneratedX86Width.mask, Reference.Word] <;> bv_decide
  | w64 =>
      have hi : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 ∨ i = 6 ∨ i = 7 := by
        simp only [Reference.X86.StackWidth.bytes] at h; omega
      rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
        simp only [GeneratedX86MemAccess.store, GeneratedX86MemAccess.storeByte,
          handlerWidth, Reference.X86.StackWidth.registerWidth, X86Cmov.handlerWidth,
          GeneratedX86Width.mask, Reference.Word] <;> bv_decide

/-- Embed the generated byte-store at its architectural wrapping address.
Permissions and initialization describe guest memory, not simulator spill slots. -/
def store (width : StackWidth) (m : Memory) (address value : Reference.Word) : Memory :=
  { m with
    value := fun a =>
      let offset := (a - address).toNat
      if offset < width.bytes then GeneratedX86MemAccess.store value (handlerWidth width) offset
      else m.value a
    initialized := fun a => if (a - address).toNat < width.bytes then true else m.initialized a }

theorem store_refines (width : StackWidth) (m : Memory) (address value : Reference.Word) :
    store width m address value = storeMemory m address value width.bytes := by
  unfold store storeMemory
  congr 1
  funext a
  dsimp only
  split <;> rename_i h
  · exact store_byte_refines width value _ h
  · rfl

def handlerStep (width : StackWidth) (src : Register) (nextPc : Reference.Word)
    (s : Reference.X86.State) : Transition Reference.X86.State :=
  let address := generatedX86PushPopAccessAt .push (s.gpr 4) (widthCode width)
  if permitted s.memory.writable address width.bytes then
    let memory := store width s.memory address (s.gpr src)
    let advanced := generatedX86PushPopRspAt .push (s.gpr 4) (widthCode width)
    ⟨{ s with gpr := (fun r => if r = 4 then advanced else s.gpr r), memory := memory, pc := nextPc },
      [.memory .write address (valueBytes (s.gpr src) width.bytes) true], none⟩
  else ⟨s, [.fault (.write address width.bytes)], some (.write address width.bytes)⟩

/-- Source RSP is captured before decrement, every other register/flag/vector
is unchanged, and a write fault leaves both registers and memory unchanged. -/
theorem step_refines (width : StackWidth) (src : Register) (nextPc : Reference.Word)
    (s : Reference.X86.State) :
    handlerStep width src nextPc s = Reference.X86.step (.push width src nextPc) s := by
  cases width <;>
    simp only [handlerStep, Reference.X86.step, widthCode, generatedX86PushPopAccessAt,
      generatedX86PushPopRspAt, GeneratedX86PushPop.stepDirection, x86PushPopToOp,
      GeneratedX86PushPop.stepBytes, GeneratedX86PushPop.resolveWidth, GeneratedX86PushPop.stackStep,
      Reference.X86.StackWidth.bytes, writeMemory, store_refines] <;>
    split <;> rename_i h <;> simp only [h, ↓reduceIte]

theorem handler_refines (width : StackWidth) (src : Register) (nextPc : Reference.Word)
    (s : Reference.X86.State) :
    Reference.X86.Step (.push width src nextPc) s (handlerStep width src nextPc s) := by
  rw [step_refines]
  exact ⟨rfl, rfl, rfl⟩

end KProgFormal.Refinement.X86Push
