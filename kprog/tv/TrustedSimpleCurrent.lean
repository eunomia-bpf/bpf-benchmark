import TrustedSimpleX86

/-! Diagnostics for the actual current-kernel B30 capture. These theorems
reject unconditional reuse of the historical B37 certificate. They do not
assert that the abstract counterexample is a realizable Linux XDP buffer. -/
set_option maxRecDepth 4096
set_option maxHeartbeats 2000000
namespace KProgTV.TrustedSimpleCurrent
open KProgFormal.Reference
open TrustedSimpleX86

def currentProof : Array Byte := #[0xb4,0x2,0x0,0x0,0x0,0x0,0x0,0x0,0xb7,0x90,0x1,0x0,0x2,0x0,0x0,0x0,0x61,0x13,0x4,0x0,0x0,0x0,0x0,0x0,0x61,0x11,0x0,0x0,0x0,0x0,0x0,0x0,0x2e,0x31,0x16,0x0,0x0,0x0,0x0,0x0,0xb7,0x4,0x0,0x0,0x8,0x0,0x0,0x0,0xf,0x14,0x0,0x0,0x0,0x0,0x0,0x0,0x2d,0x34,0x13,0x0,0x0,0x0,0x0,0x0,0xbf,0x14,0x0,0x0,0x0,0x0,0x0,0x0,0x7,0x4,0x0,0x0,0x48,0x0,0x0,0x0,0x2d,0x34,0x10,0x0,0x0,0x0,0x0,0x0,0xb7,0x2,0x0,0x0,0x0,0x0,0x0,0x0,0xb7,0x3,0x0,0x0,0x0,0x0,0x0,0x0,0xf,0x13,0x0,0x0,0x0,0x0,0x0,0x0,0xb7,0x4,0x0,0x0,0x4e,0x61,0x0,0x0,0x6b,0x43,0x0,0x0,0x0,0x0,0x0,0x0,0xb7,0x3,0x0,0x0,0x2,0x0,0x0,0x0,0xf,0x13,0x0,0x0,0x0,0x0,0x0,0x0,0xb7,0x4,0x0,0x0,0xbc,0x0,0x0,0x0,0x73,0x43,0x0,0x0,0x0,0x0,0x0,0x0,0xb7,0x3,0x0,0x0,0x3,0x0,0x0,0x0,0xf,0x13,0x0,0x0,0x0,0x0,0x0,0x0,0x63,0x23,0x0,0x0,0x0,0x0,0x0,0x0,0xb7,0x3,0x0,0x0,0x7,0x0,0x0,0x0,0xf,0x13,0x0,0x0,0x0,0x0,0x0,0x0,0x73,0x23,0x0,0x0,0x0,0x0,0x0,0x0,0xb4,0x2,0x0,0x0,0x2,0x0,0x0,0x0,0xbc,0x20,0x0,0x0,0x0,0x0,0x0,0x0,0x5,0x0,0x0,0x0,0x0,0x0,0x0,0x0,0x95,0x0,0x0,0x0,0x0,0x0,0x0,0x0]

theorem current_size : currentProof.size = 240 := rfl
theorem current_decode4 : BPF.decode currentProof 4 = .ok ⟨0x2e,1,3,22,0⟩ := rfl

def currentGuardFinal (s : BPF.State) : BPF.State :=
  { s with pc := if (s.regs 1).setWidth 32 > (s.regs 3).setWidth 32 then 27 else 5 }

/-- The actual captured opcode truncates both operands, irrespective of the
64-bit physical context load expansion. No second BPF semantics is used. -/
theorem current_guard_step (env : BPF.Environment) (s : BPF.State)
    (position : s.pc = 4) (active : s.halted = false) :
    BPF.step env currentProof s = .ok ⟨currentGuardFinal s,[],none⟩ := by
  simp +decide [BPF.step,position,active,current_decode4,BPF.execute,
    BPF.source,BPF.comparison,currentGuardFinal,
    Except.bind,Except.pure,Bind.bind,Pure.pure,Except.instMonad]

def crossingData : Word := 0xfffffff0
def crossingEnd : Word := 0x100000080

/-- A144-byte interval across2^32 reverses this guard's decision. A physical
ABI proof would have to rule it out; no such premise is silently added here. -/
theorem current_guard_divergence (env : BPF.Environment) (n : X86.State) (p : BPF.State)
    (nativePC : n.pc = 7) (proofPC : p.pc = 4) (active : p.halted = false)
    (nativeData : n.gpr 1 = crossingData) (nativeEnd : n.gpr 2 = crossingEnd)
    (proofData : p.regs 1 = crossingData) (proofEnd : p.regs 3 = crossingEnd) :
    X86Path.Execution 0 native n [] (guardFinal n) ∧
    (guardFinal n).pc = 17 ∧
    BPF.step env currentProof p = .ok ⟨{p with pc := 27},[],none⟩ := by
  refine ⟨native_first_guard n nativePC,?_,?_⟩
  · simp only [guardFinal,nativeData,nativeEnd]
    decide
  · rw [current_guard_step env p proofPC active]
    have taken : (crossingData.setWidth 32 > crossingEnd.setWidth 32) = true := by decide
    simp only [currentGuardFinal,proofData,proofEnd,taken,ite_true]

-- The physical image is the DECLARED standard XDP layout interpretation,
-- not an observation of a post-conversion kernel instruction array.
def currentPhysical : Array Byte := currentProof.extract 0 16 ++
  #[0x79,0x13,8,0,0,0,0,0, 0x79,0x11,0,0,0,0,0,0] ++
  currentProof.extract 32 currentProof.size

def readableZero : Memory where
  value := fun _ => 0
  readable := fun _ => true
  writable := fun _ => true
  initialized := fun _ => true

def nativeContext : X86.State where
  gpr := fun r => if r=7 then 0x1000 else 0
  rflags := 0
  xmm0 := 0
  memory := readableZero
  pc := 0
  fsBase := 0
  gsBase := 0

def proofContext : BPF.State where
  regs := fun r => if r=1 then 0x1000 else 0
  memory := readableZero
  pc := 0

def contextEnvironment : BPF.Environment :=
  { externals with nativeInput := fun _ => .ok 0 }

def nativeContextEvents : List Event :=
  [.memory .read 0x1000 (List.replicate 8 0) true,
   .memory .read 0x1008 (List.replicate 8 0) true]

def proofContextEvents : List Event :=
  match BPFPath.evaluate contextEnvironment currentPhysical [0,1,2,3,4] proofContext with
  | .ok result => result.events
  | .error _ => []

theorem native_context_read_order :
    X86Path.Execution 0 native nativeContext nativeContextEvents
      (nativePrefixFinal nativeContext 0 0) := by
  apply native_two_loads nativeContext 0 0
    (.memory .read 0x1000 (List.replicate 8 0) true)
    (.memory .read 0x1008 (List.replicate 8 0) true) rfl
  · rfl
  · rfl

theorem current_context_read_order : proofContextEvents =
    [.memory .read 0x1008 (List.replicate 8 0) true,
     .memory .read 0x1000 (List.replicate 8 0) true] := by decide

/-- Even on successful initialized context reads, the two ordered context-read
prefixes differ. They cannot be equated by private-spill erasure. -/
theorem context_trace_mismatch : nativeContextEvents ≠ proofContextEvents := by
  rw [current_context_read_order]
  decide


