theorem candidate_decode4 : BPF.decode candidateProof 4 = .ok ⟨0x2d,2,1,22,0⟩ := rfl

def candidateGuardFinal (s : BPF.State) : BPF.State :=
  {s with pc := if s.regs 2 > s.regs 1 then 27 else 5}

theorem candidate_guard_step (env : BPF.Environment) (s : BPF.State)
    (position : s.pc = 4) (active : s.halted = false) :
    BPF.step env candidateProof s = .ok ⟨candidateGuardFinal s,[],none⟩ := by
  simp +decide [BPF.step,position,active,candidate_decode4,BPF.execute,
    BPF.source,BPF.comparison,candidateGuardFinal,
    Except.bind,Except.pure,Bind.bind,Pure.pure,Except.instMonad]

/-- Both arbitrary64-bit guard choices now agree, with no restriction to
32-bit inputs or an assumed compiler flag result. This is a local component. -/
theorem candidate_guard_successor (n : X86.State) (p : BPF.State)
    (data : n.gpr 1 = p.regs 2) (limit : n.gpr 2 = p.regs 1) :
    (candidateGuardFinal p).pc = if (guardFinal n).pc = 60 then 27 else 5 := by
  simp only [candidateGuardFinal,guardFinal,data,limit]
  split <;> simp_all

def candidatePhysical : Array Byte := candidateProof.extract 0 8 ++
  #[0x79,0x12,0,0,0,0,0,0, 0x79,0x11,8,0,0,0,0,0] ++
  candidateProof.extract 24 candidateProof.size

def candidateContextEvents : List Event :=
  match BPFPath.evaluate contextEnvironment candidatePhysical [0,1,2,3,4] proofContext with
  | .ok result => result.events
  | .error _ => []

theorem candidate_context_read_order : candidateContextEvents = nativeContextEvents := by decide

