install -d /run/bpf-benchmark-docker /run/bpf-benchmark-docker/data /run/bpf-benchmark-docker/exec
truncate -s "${BPFREJIT_VM_DOCKER_DISK_SIZE:-64G}" /var/tmp/bpf-benchmark-docker.img
mkfs.ext4 -F -q /var/tmp/bpf-benchmark-docker.img
mount -o loop,discard /var/tmp/bpf-benchmark-docker.img /run/bpf-benchmark-docker
"/workspaces/repository/runner/scripts/start-vm-docker"
install -d "/workspaces/repository/corpus/results"
"/workspaces/repository/runner/scripts/bpfrejit-install" --image "bpf-benchmark/kprog-five-step-tracee:c-runner" "/workspaces/repository/.cache/container-images/x86_64-runner-runtime.image.tar"
docker run --rm --privileged --pid=host --network=host --ipc=host --cgroupns=host -e BPFREJIT_INSIDE_RUNTIME_CONTAINER=1 -e HOME=/root -e TARGET="x86-kvm" -e RUN_TARGET_NAME="x86-kvm" -e RUN_TOKEN="988a0c4d" -e RUN_TARGET_ARCH="x86_64" -e RUN_EXECUTOR="kvm" -e RUN_REMOTE_PYTHON_BIN="python3" -e RUN_RUNTIME_PYTHON_BIN="python3" -e RUN_BPFTOOL_BIN="bpftool" -e RUN_NATIVE_REPOS_CSV="bcc,katran,tracee,tetragon" -e SAMPLES="3"      -e FUZZ_ROUNDS="1000"                -e MERLIN_COMPILETIME_MODE="none"                     -e CILIUM_PROFILE_ARM="all"    -w "/workspaces/repository" -v /sys:/sys -v /sys/fs/bpf:/sys/fs/bpf -v /sys/kernel/debug:/sys/kernel/debug -v /lib/modules:/lib/modules:ro -v /boot:/boot:ro -v "/workspaces/repository/corpus/results:/workspaces/repository/corpus/results" "bpf-benchmark/kprog-five-step-tracee:c-runner" python3 -m corpus.driver
