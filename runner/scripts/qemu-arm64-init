#!/bin/sh

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

[ -d /run ] || mkdir -p /run
[ -d /tmp ] || mkdir -p /tmp
[ -d /var/tmp ] || mkdir -p /var/tmp
[ -d /dev/shm ] || mkdir -p /dev/shm
[ -d /sys/kernel/debug ] || mkdir -p /sys/kernel/debug
[ -d /sys/fs/bpf ] || mkdir -p /sys/fs/bpf
if [ -d /artifacts/lib/modules ] && [ ! -e /lib/modules ]; then
    ln -sfn /artifacts/lib/modules /lib/modules
fi
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run 2>/dev/null || chmod 0755 /run 2>/dev/null || true
[ -d /run/netns ] || mkdir -p /run/netns
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp 2>/dev/null || chmod 1777 /tmp 2>/dev/null || true
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /var/tmp 2>/dev/null || chmod 1777 /var/tmp 2>/dev/null || true
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm 2>/dev/null || chmod 1777 /dev/shm 2>/dev/null || true
[ -d /var/tmp/bpfrejit-runtime ] || mkdir -p /var/tmp/bpfrejit-runtime

mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true
mount -t bpf bpffs /sys/fs/bpf 2>/dev/null || true
ulimit -l unlimited 2>/dev/null || true

export HOME=/root
export BPFREJIT_INSIDE_RUNTIME_CONTAINER=1
export BPFREJIT_IMAGE_WORKSPACE=/home/yunwei37/workspace/bpf-benchmark
export BPFREJIT_REPO_ARTIFACT_ROOT=/artifacts/user/repo-artifacts/arm64
export BPFREJIT_NATIVE_LOADER_SO=/usr/local/lib/bpfrejit/libnative_loader.so
export BPFREJIT_NATIVE_LOADER_REQUIRE_PREBUILT_PROOF=1
export BPFREJIT_KERNEL_MODULES_ROOT=/artifacts
export PYTHONPATH=/home/yunwei37/workspace/bpf-benchmark
export PATH=/home/yunwei37/workspace/bpf-benchmark/runner/build-arm64-llvmbpf:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

cd /home/yunwei37/workspace/bpf-benchmark || exit 127

if [ ! -x /qemu-run.sh ]; then
    echo "missing executable /qemu-run.sh" >&2
    status=127
else
    /qemu-run.sh
    status=$?
fi

echo "$status" >/qemu-status
sync

if [ -w /proc/sys/kernel/sysrq ]; then
    echo 1 >/proc/sys/kernel/sysrq
fi
if [ -w /proc/sysrq-trigger ]; then
    echo o >/proc/sysrq-trigger
    while :; do
        sleep 60 2>/dev/null || true
    done
fi

exit "$status"
