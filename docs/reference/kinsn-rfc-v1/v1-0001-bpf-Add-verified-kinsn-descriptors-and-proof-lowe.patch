+	struct btf_kfunc_kinsn_set *set;
+	struct btf_kfunc_kinsn_desc *desc;
+
+	if (hook >= BTF_KFUNC_HOOK_MAX)
+		return NULL;
+	if (!btf->kfunc_set_tab)
+		return NULL;
+	set = btf->kfunc_set_tab->kinsn_sets[hook];
+	if (!set)
+		return NULL;
+	desc = bsearch(&key, set->descs, set->cnt, sizeof(set->descs[0]),
+		       btf_id_cmp_func);
