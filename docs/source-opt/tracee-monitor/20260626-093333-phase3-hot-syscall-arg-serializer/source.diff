diff --git a/pkg/ebpf/c/common/buffer.h b/pkg/ebpf/c/common/buffer.h
index 6cff96388..35333667a 100644
--- a/pkg/ebpf/c/common/buffer.h
+++ b/pkg/ebpf/c/common/buffer.h
@@ -585,6 +585,49 @@ static u32 type_size_table[ARG_TYPE_MAX_ARRAY + 1] = {
     [TIMESPEC_T] = 0,
 };
 
+statfunc int save_hot_syscall_args_to_submit_buf(event_data_t *event, args_t *args)
+{
+    switch (event->context.eventid) {
+        case SYSCALL_SETUID:
+        case SYSCALL_SETGID:
+            return save_to_submit_buf(&event->args_buf, &args->args[0], sizeof(int), 0);
+        case SYSCALL_KILL:
+        case SYSCALL_TKILL:
+            return save_to_submit_buf(&event->args_buf, &args->args[0], sizeof(int), 0) +
+                   save_to_submit_buf(&event->args_buf, &args->args[1], sizeof(int), 1);
+        case SYSCALL_TGKILL:
+            return save_to_submit_buf(&event->args_buf, &args->args[0], sizeof(int), 0) +
+                   save_to_submit_buf(&event->args_buf, &args->args[1], sizeof(int), 1) +
+                   save_to_submit_buf(&event->args_buf, &args->args[2], sizeof(int), 2);
+        case SYSCALL_EVENTFD2:
+            return save_to_submit_buf(&event->args_buf, &args->args[0], sizeof(uint), 0) +
+                   save_to_submit_buf(&event->args_buf, &args->args[1], sizeof(int), 1);
+        case SYSCALL_SIGNALFD4:
+            return save_to_submit_buf(&event->args_buf, &args->args[0], sizeof(int), 0) +
+                   save_to_submit_buf(&event->args_buf, &args->args[1], sizeof(void *), 1) +
+                   save_to_submit_buf(&event->args_buf, &args->args[2], sizeof(unsigned long), 2) +
+                   save_to_submit_buf(&event->args_buf, &args->args[3], sizeof(int), 3);
+#if defined(bpf_target_x86)
+        case SYSCALL_EVENTFD:
+            return save_to_submit_buf(&event->args_buf, &args->args[0], sizeof(uint), 0);
+        case SYSCALL_SIGNALFD:
+            return save_to_submit_buf(&event->args_buf, &args->args[0], sizeof(int), 0) +
+                   save_to_submit_buf(&event->args_buf, &args->args[1], sizeof(void *), 1) +
+                   save_to_submit_buf(&event->args_buf, &args->args[2], sizeof(int), 2);
+#endif
+        case SYSCALL_FUTEX:
+            return save_to_submit_buf(&event->args_buf, &args->args[0], sizeof(void *), 0) +
+                   save_to_submit_buf(&event->args_buf, &args->args[1], sizeof(int), 1) +
+                   save_to_submit_buf(&event->args_buf, &args->args[2], sizeof(int), 2) +
+                   save_to_submit_buf(&event->args_buf, (void *) args->args[3],
+                                      bpf_core_type_size(struct __kernel_timespec), 3) +
+                   save_to_submit_buf(&event->args_buf, &args->args[4], sizeof(void *), 4) +
+                   save_to_submit_buf(&event->args_buf, &args->args[5], sizeof(int), 5);
+    }
+
+    return -1;
+}
+
 statfunc int save_args_to_submit_buf(event_data_t *event, args_t *args)
 {
     u8 i;
@@ -599,6 +642,10 @@ statfunc int save_args_to_submit_buf(event_data_t *event, args_t *args)
     if (unlikely(event->config.field_types == 0))
         return 0;
 
+    int hot_arg_num = save_hot_syscall_args_to_submit_buf(event, args);
+    if (hot_arg_num >= 0)
+        return hot_arg_num;
+
 #pragma unroll
     for (i = 0; i < 6; i++) {
         type = DEC_ARG(i, event->config.field_types);
