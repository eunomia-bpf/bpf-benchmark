+statfunc int save_simple_value_args_to_submit_buf(event_data_t *event, args_t *args)
+{
+    u32 rc = 0;
+    u32 arg_num = 0;
+    u32 size = 0;
+
+#pragma unroll
+    for (u8 i = 0; i < 6; i++) {
+        switch (DEC_ARG(i, event->config.field_types)) {
+            case NONE_T:
+                continue;
+            case INT_T:
+                size = sizeof(int);
+                break;
+            case UINT_T:
+                size = sizeof(uint);
+                break;
+            case LONG_T:
+                size = sizeof(long);
+                break;
+            case ULONG_T:
+                size = sizeof(unsigned long);
+                break;
+            case POINTER_T:
+                size = sizeof(void *);
+                break;
+            default:
+                return -1;
+        }
+
+        rc = save_to_submit_buf(&(event->args_buf), &args->args[i], size, i);
+        if (rc > 0) {
+            arg_num++;
+            rc = 0;
+        }
+    }
+
+    return arg_num;
+}
