+statfunc bool field_types_are_simple_values(u64 field_types)
+{
+#pragma unroll
+    for (u8 i = 0; i < 6; i++) {
+        u8 type = DEC_ARG(i, field_types);
+        if (type == NONE_T)
+            continue;
+        if (unlikely(type > ARG_TYPE_MAX_ARRAY))
+            return false;
+        if (!(((u64) 1 << type) & BITMASK_SIMPLE_VALUE_TYPES))
+            return false;
+    }
+
+    return true;
+}
