+#if defined(bpf_target_x86)
+statfunc u8 tracee_hot_syscall_arg_count(int id)
+{
+    switch (id) {
+        case 62:  // kill
+        case 113: // setreuid
+        case 114: // setregid
+        case 125: // capget
+        case 126: // capset
+        case 200: // tkill
+        case 290: // eventfd2
+            return 2;
+        case 105: // setuid
+        case 106: // setgid
+        case 122: // setfsuid
+        case 123: // setfsgid
+        case 284: // eventfd
+            return 1;
+        case 117: // setresuid
+        case 119: // setresgid
+        case 234: // tgkill
+        case 282: // signalfd
+            return 3;
+        case 289: // signalfd4
+            return 4;
+        case 157: // prctl
+            return 5;
+    }
+    return 6;
+}
+#endif
