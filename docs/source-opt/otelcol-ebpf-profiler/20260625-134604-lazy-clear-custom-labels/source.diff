diff --git a/support/ebpf/tracemgmt.h b/support/ebpf/tracemgmt.h
index 7a30122..e60a5e3 100644
--- a/support/ebpf/tracemgmt.h
+++ b/support/ebpf/tracemgmt.h
@@ -246,6 +246,8 @@ static inline EBPF_INLINE PerCPURecord *get_pristine_per_cpu_record()
   record->unwindersDone                    = 0;
   record->tailCalls                        = 0;
   record->ratelimitAction                  = RATELIMIT_ACTION_DEFAULT;
+  bool clear_custom_labels                  = record->customLabelsState.go_m_ptr != NULL ||
