+FUNC_INLINE unsigned long
+get_configured_ctx_arg(struct generic_tracepoint_event_arg *ctx,
+		       struct event_config *config, int arg)
+{
+	unsigned long ctx_off;
+	int ty = config->arg[arg];
+
+	if (ty == nop_ty)
+		return 0;
+	ctx_off = config->off[arg];
+	asm volatile("%[ctx_off] &= 0xffff;\n"
+		     : [ctx_off] "+r"(ctx_off));
+	return get_ctx_ul((char *)ctx + ctx_off, ty);
+}
+
+FUNC_INLINE bool
+generic_tracepoint_curr_no_selector_filter(struct msg_generic_kprobe *msg,
+					   struct event_config *config)
+{
+	struct execve_map_value *enter;
+	__u32 ppid;
+	bool walker = 0;
+
+	if (!(config->flags & EVENT_CONFIG_FLAG_NO_SELECTORS))
+		return false;
+	enter = event_find_curr(&ppid, &walker);
+	if (!enter)
+		return false;
+	msg->current.pid = enter->key.pid;
+	msg->current.ktime = enter->key.ktime;
+	msg->sel.pass = true;
+	return true;
+}
