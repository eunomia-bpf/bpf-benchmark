--- a/bpf/lib/trace.h
+++ b/bpf/lib/trace.h
@@ -264,15 +264,9 @@ _send_trace_notify4(struct __ctx_buff *ctx, enum trace_point obs_point,
 		    __u32 ifindex, enum trace_reason reason, __u32 monitor,
 		    __u16 line, __u8 file)
 {
-	__u64 ip_trace_id = load_ip_trace_id();
-	__u64 ctx_len = ctx_full_len(ctx);
+	__u64 ip_trace_id;
+	__u64 ctx_len;
 	__u64 cap_len;
-	struct ratelimit_key rkey = {
-		.usage = RATELIMIT_USAGE_EVENTS_MAP,
-	};
-	struct ratelimit_settings settings = {
-		.topup_interval_ns = NSEC_PER_SEC,
-	};
 	struct trace_notify msg = {};
 	cls_flags_t flags = CLS_FLAG_NONE;
 
@@ -282,12 +276,21 @@ _send_trace_notify4(struct __ctx_buff *ctx, enum trace_point obs_point,
 		return;
 
 	if (CONFIG(events_map_rate_limit) > 0) {
+		struct ratelimit_key rkey = {
+			.usage = RATELIMIT_USAGE_EVENTS_MAP,
+		};
